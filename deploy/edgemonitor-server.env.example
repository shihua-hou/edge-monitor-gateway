# EdgeMonitor 服务器侧环境变量
# 部署：cp edgemonitor-server.env.example /etc/edgemonitor-server.env && chmod 600 /etc/edgemonitor-server.env
# 跟机器人侧的 /etc/edgemonitor.env 是两份，别混用——这台机器上 broker 就在本机

MQTT_HOST=localhost
MQTT_USER=em
MQTT_PASS=改成你自己的密码

# ── 历史数据 ──
HIST_DB=/opt/edgemonitor/edgemonitor.db
HIST_PORT=8090
# 保留天数。按 5 秒采样估算，一天约 1.7 万条 status，
# 30 天连同 imu/motor 大概几十 MB 量级，VM 上毫无压力
HIST_KEEP_DAYS=30
