# EdgeMonitor 机器人侧环境变量
# 部署时复制到 /etc/edgemonitor.env 并按实际情况修改：
#   cp edgemonitor.env.example /etc/edgemonitor.env && chmod 600 /etc/edgemonitor.env
# 里面有 broker 密码，权限要收紧，别让它跟着源码一起进版本库。

# ── MQTT broker ──
# 注意：这里填的是【服务器/VM 的地址】，不是 localhost。
# broker 已经从机器人上迁到服务器侧了——它要是跟设备同机，设备一断电
# broker 跟着没了，LWT 遗嘱没人执行，大屏就永远分不清"设备静默"和"真掉线"。
MQTT_HOST=192.168.100.6
MQTT_USER=em
MQTT_PASS=改成你自己的密码

# ── 设备标识 ──
# 一台机器人一个 id，大屏靠它区分多设备（topic: monitor/online/<DEVICE_ID>）
DEVICE_ID=robot01

# ── OTA ──
OTA_FW_DIR=/root/monitor/fw/
OTA_UDS_TOOL=/root/monitor/bin/uds_tool
