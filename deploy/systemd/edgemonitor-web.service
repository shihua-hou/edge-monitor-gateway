[Unit]
Description=EdgeMonitor Web Dashboard (static files + video relay)
After=network.target

[Service]
Type=simple
User=user
Group=user

# ── 为什么不再用 python3 -m http.server ──
#
# 以前这里写着"服务器这边不需要任何动态能力"——那时视频由浏览器直接去连板子。
# 实测那条路很脆：浏览器会限制网页去访问局域网里的另一台设备
# （页面从 fly260305.local 打开时，去 192.168.100.3 的请求被直接拦掉），
# 通过 Tailscale 在外面访问时更是根本到不了板子的局域网 IP。
# 改成服务器同源中转 /video 之后，浏览器只跟这一个地址打交道。
# 细节和安全限制（只转发到局域网私有 IP 的 8081）见 server/web_server.py。
#
# ── 两个版本相关的坑 ──
# 这台 VM 是 Python 3.6.9：
#   - http.server 的 --directory、ThreadingHTTPServer 都是 3.7 才有，
#     web_server.py 里用 os.chdir + ThreadingMixIn 绕开了
#   - 3.6 在 stderr 重定向时是**块缓冲**，日志攒在缓冲区里不落盘，
#     journalctl 里长时间一个字都没有，看着像服务卡死。所以必须加 -u
Environment=EM_WEB_PORT=8080
Environment=EM_WEB_DIR=/home/user/edgemonitor/web
WorkingDirectory=/home/user/edgemonitor
ExecStart=/usr/bin/python3 -u /home/user/edgemonitor/server/web_server.py

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=em-web

[Install]
WantedBy=multi-user.target
